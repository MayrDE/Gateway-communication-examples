    {
        "id": "ccae5faf76a2d88b",
        "type": "function",
        "z": "1e0c503d21209aeb",
        "name": "modify topic",
        "func": "var newMsg = msg;\n\n//get the variables\nvar mqttModuleId = null;\nvar topicBase = global.get(\"topicBase\");\nvar topicSpecification = msg.topicSpecification;\nvar device = msg.device;\nif(device == \"Gateway\"){\n    mqttModuleId = global.get(\"gatewaySerialnumber\");\n}\nelse if(device == \"RBC\"){\n    mqttModuleId = global.get(\"rbcSerialnumber\");\n}\n\n\n\nif(topicBase == \"\"){\n    newMsg.topic = device + \"/\" + mqttModuleId + \"/\" + topicSpecification;\n}\nelse{\n    newMsg.topic = topicBase + \"/\" + device + mqttModuleId + \"/\" + topicSpecification;\n}\n\nreturn newMsg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 500,
        "wires": [
            [
                "e051d95589d06aca",
                "6b1ac0cf974b3e94"
            ]
        ]
