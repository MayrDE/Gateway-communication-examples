    {
        "id": "59c3efb2d5852b07",
        "type": "function",
        "z": "22386f0231bbaea0",
        "name": "prepareLogin",
        "func": "var hostname = flow.get(\"hostname\");\nvar userlevel = msg.userlevel;\nvar password = msg.password;\nvar path = \"\";\n\n\nif (userlevel == \"Customer\") {\n    //send dummy message for feature which requires level Customer\n    path = \"/Gateway/Output/0\";\n    msg.payload = \"{\\\"Dummy\\\": \\\"dummy\\\"}\";\n}\nelse if(userlevel == \"Service\"){\n    //send dummy message for feature which requires level Service\n    //gateway will not do any action, as payload is not valid\n    path = \"/Gateway/GlobalLogLevel\";\n    msg.payload = \"{\\\"Dummy\\\": \\\"dummy\\\"}\";\n}\nelse\n{\n    msg.error(\"Unknown Userlevel\")\n}\n\nmsg.url = \"http://\" + hostname + path;\n// set Basic Authorization header using Base64(user:pass)\nvar creds = Buffer.from(userlevel + \":\" + password).toString(\"base64\");\nmsg.headers = msg.headers || {};\nmsg.headers.Authorization = \"Basic \" + creds;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 260,
        "wires": [
            [
                "4b695165b0d287b8",
                "763f6f4f6d96b0e1"
            ]
        ]
    },
