        "id": "675eed9aa05362d5",
        "type": "function",
        "z": "9727d69723ecfd0b",
        "name": "Modify URL",
        "func": "var newMsg = msg;\n\n//get the global variables\nvar hostname = global.get(\"Hostname\");\nvar userlevel = global.get(\"Userlevel\")\nvar password = global.get(\"Password\");\n\n//for debugging\nnewMsg.UserLevel = userlevel;\nnewMsg.Password = password;\n\n//build the url\n//http://username:password@hostname/\nnewMsg.url = \"http://\" + userlevel + \":\" + password + \"@\" + hostname + msg.topic;\n\nreturn [newMsg]",
