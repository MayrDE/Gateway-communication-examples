    {
        "id": "64598e32cd7f6141",
        "type": "function",
        "z": "9727d69723ecfd0b",
        "name": "format",
        "func": "function insertParagraphs(jsonText) {\n    // Insert <p> after every '{'\n    jsonText = jsonText.replace(/{/g, '{<p>');\n    // Insert <p> after every ','\n    jsonText = jsonText.replace(/,/g, ',<p>');\n    // Insert <p> before every '}'\n    jsonText = jsonText.replace(/}/g, '<p>}');\n    return jsonText;\n}\n\n\nmsg.payload = JSON.stringify(msg.payload,null,2)\nmsg.payload = insertParagraphs(msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
