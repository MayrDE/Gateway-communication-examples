        "func": "//Set the correct hostname, userlevel and password here!\nlet hostname = \"gateway-2521d00163/\";\nlet userlevel = \"Customer\";\nlet password = \"kx2521D00163!\";\n\n\n//Dashboard init values\n//DO NOT CHANGE THE FOLLOWING\nflow.set (\"Run\", false);\nflow.set (\"Outputnumber\", 0);\nflow.set (\"RBCPage\", 1);\nglobal.set(\"Hostname\", hostname);\nglobal.set(\"Userlevel\", userlevel);\nglobal.set(\"Password\", password);\n\n\n\n",
