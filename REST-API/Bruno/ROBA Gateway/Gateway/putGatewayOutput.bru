meta {
  name: putGatewayOutput
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/Gateway/Output/:channel
  body: json
  auth: basic
}

params:path {
  channel: 
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

docs {
  # putGatewayOutput

  Set an output of the gateway.

  ## Required service level

  `Customer`

  ## Parameters

  `channel`

  - type: integer (uint8)
  - minimum: 0
  - maximum: 1

  ## Body

  `OnOff`

  - `Value`: boolean

  ### Example

  ```json
  {
	"Value": true
  }
  ```

  ## Response

  `204 No Content`

  or

  `400 Bad Request`

  or

  `401 Not Authorized`
}

body:json {
  {
    "Value": false
  }
}

