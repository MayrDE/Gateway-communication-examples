          "StaticIP": {
            "StaticIPAddress": "",
            "StaticSubnet": "",
            "StaticGateway": "",
            "StaticDNS1": "",
            "StaticDNS2": ""
          },
          "NtpSettings": {
            "Enabled": false,
            "Server": ""
          }
        }
      '''
    }
  }
}
