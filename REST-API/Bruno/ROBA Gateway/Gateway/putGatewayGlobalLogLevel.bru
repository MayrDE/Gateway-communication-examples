meta {
  name: putGatewayGlobalLogLevel
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/Gateway/GlobalLogLevel
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

docs {
  # putGatewayGlobalLogLevel

  Update the global log level of the gateway.

  ## Required service level

  `Service`

  ## Body

  `LogLevel`

  - `Value`: integer 0..5

  ### Example

  ```json
  {
	"Value": 3
  }
  ```

  ## Response

  `204 No Content`

  or

  `400 Bad Request`

  or

  `401 Not Authorized`
}

body:json {
  {
    "Value": 0
  }
}

