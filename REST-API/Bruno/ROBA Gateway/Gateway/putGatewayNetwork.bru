meta {
  name: putGatewayNetwork
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/Gateway/Network
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

docs {
  # putGatewayNetwork

  Set Gateway network settings.

  ## Required service level

  `Service`

  ## Body

  `NetworkSettings`

  ### Example

  ```json
  {
	"hostname": "gateway-001",
	"NetworkType": 1,
	"StaticIP": {
		"StaticIPAddress": "192.168.1.10",
		"StaticSubnet": "255.255.255.0",
		"StaticGateway": "192.168.1.1",
		"StaticDNS1": "8.8.8.8",
		"StaticDNS2": "1.1.1.1"
	},
	"NtpSettings": {
		"Enabled": true,
		"Server": "pool.ntp.org"
	}
  }
  ```

  ## Response

  `204 No Content`

  or

  `400 Bad Request`

  or

  `401 Not Authorized`
}

body:json {
  {
    "hostname": "gateway-2521D00163",
    "NetworkType": 1,
    "dynamicIp": "192.168.4.2",
    "dynamicSubnetMask": "255.255.0.0",
    "dynamicGateway": "192.168.4.1",
    "dynamicDNS1": "0.0.0.0",
    "dynamicDNS2": "0.0.0.0",
    "StaticIP": {
      "StaticIPAddress": "192.168.4.2",
      "StaticSubnet": "255.255.0.0",
      "StaticGateway": "192.168.4.1",
      "StaticDNS1": "192.168.4.1",
      "StaticDNS2": "192.168.4.1"
    },
    "NtpSettings": {
      "Enabled": false,
      "Server": "192.168.4.1"
    }
  }
}

