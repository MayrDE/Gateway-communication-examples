get {
  url: {{baseUrl}}/Gateway/Input/:channel
  body: none
  auth: inherit
}

docs {
  # getGatewayInput

  Get the state of an input from the gateway.

  ## Required service level

  `none`

  ## Parameters

  `channel`

  - type: integer (uint8)
  - minimum: 0
  - maximum: 1

  ## Body

  `none`

  ## Response

  `200 OK` (On/Off)

  ### Example

  ```json
  {
	"Value": true
  }
  ```
}

params:path {
  channel: 
}

